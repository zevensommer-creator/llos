{
  "name": "llos",
  "private": true,
  "version": "0.1.0",
  "description": "LLOS - Language Learning Operating System (monorepo root)",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "contracts:generate": "pnpm --filter @llos/contracts generate",
    "metrics:speech": "node scripts/speech-metrics.mjs",
    "demo:loop": "node scripts/demo-loop.mjs"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@llos/compiler": "workspace:*",
    "@llos/core": "workspace:*",
    "@llos/speech": "workspace:*"
  }
}
