{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:language-learning-platform:schema:learning-claim:0.2.0",
  "title": "Learning Claim",
  "description": "A DLC-declared, theory-neutral learning claim. claim_ref is opaque to Core; descriptors are display artifacts, not Core enums (spec §4.2).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_ref",
    "dlc_ref",
    "version",
    "descriptor"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "claim_ref": {
      "$ref": "#/$defs/ClaimRef"
    },
    "dlc_ref": {
      "$ref": "#/$defs/VersionedRef"
    },
    "version": {
      "$ref": "#/$defs/SemVer"
    },
    "descriptor": {
      "$ref": "#/$defs/ClaimDescriptor"
    },
    "claim_schema_ref": {
      "$ref": "#/$defs/ArtifactRef",
      "description": "Optional registered schema typing claim-specific descriptor payloads."
    },
    "claims_transfer": {
      "type": "boolean",
      "default": false,
      "description": "Whether the claim asserts transferability; if true the evidence policy must require context-diversity evidence."
    },
    "extensions": {
      "$ref": "#/$defs/Extensions"
    }
  },
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "ClaimRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*:claim/[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "SemVer": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "VersionedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "version": {
          "$ref": "#/$defs/SemVer"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "origin": {
          "enum": [
            "stored",
            "uploaded",
            "generated_random",
            "generated_instructed",
            "derived"
          ]
        }
      }
    },
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "sha256"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "schema_id": {
          "$ref": "#/$defs/Identifier"
        },
        "schema_version": {
          "$ref": "#/$defs/SemVer"
        }
      }
    },
    "LevelRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scale_ref",
        "level_ref",
        "scale_version"
      ],
      "properties": {
        "scale_ref": {
          "$ref": "#/$defs/Identifier",
          "description": "Opaque level-scale identifier, e.g. a CEFR scale artifact; Core does not interpret it."
        },
        "level_ref": {
          "$ref": "#/$defs/Identifier"
        },
        "scale_version": {
          "$ref": "#/$defs/SemVer"
        }
      }
    },
    "ClaimDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 4000
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "level_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LevelRef"
          }
        },
        "descriptor_artifact_ref": {
          "$ref": "#/$defs/ArtifactRef",
          "description": "Rich theory-specific descriptor content as a schema-validated artifact, never inline arbitrary JSON."
        }
      }
    },
    "ExtensionEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "payload_ref"
      ],
      "properties": {
        "schema_id": {
          "$ref": "#/$defs/Identifier"
        },
        "schema_version": {
          "$ref": "#/$defs/SemVer"
        },
        "payload_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uri",
            "sha256"
          ],
          "properties": {
            "uri": {
              "type": "string",
              "format": "uri"
            },
            "sha256": {
              "$ref": "#/$defs/Sha256"
            }
          }
        }
      }
    },
    "Extensions": {
      "type": "object",
      "default": {},
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/ExtensionEnvelope"
      }
    }
  }
}
