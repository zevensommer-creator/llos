{
  "name": "@llos/api",
  "version": "0.1.0",
  "private": true,
  "description": "LLOS API composition root: wires real domain services (Core/Market/Gateway/Studio) into a single backend and exposes a deterministic JSON-RPC handler + node:http server for the HttpApiClient vertical slice (T-037)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server-cli.js",
    "test": "tsc -p tsconfig.json && node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@llos/core": "workspace:*",
    "@llos/contracts": "workspace:*",
    "@llos/compiler": "workspace:*",
    "@llos/gateway": "workspace:*",
    "@llos/market": "workspace:*",
    "@llos/studio": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
