{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:language-learning-platform:schema:material-pack:0.1.0",
  "title": "Material Pack",
  "description": "Versioned, licensable material layer consumed by DLC compilers. It contains source media and semantic facts, not a fixed teaching method.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "version",
    "display_name",
    "pack_kind",
    "languages",
    "target_levels",
    "compatibility",
    "semantic_frames",
    "assets",
    "generation_policy",
    "license",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "pack_id": {
      "$ref": "#/$defs/Identifier"
    },
    "version": {
      "$ref": "#/$defs/SemVer"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "pack_kind": {
      "enum": [
        "semantic_scenario",
        "authentic_corpus",
        "graded_reader",
        "domain_lexicon",
        "media_collection",
        "annotation_overlay",
        "mixed"
      ]
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/LanguageTag"
      }
    },
    "target_levels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(pre-)?[ABC][12](?:\\+)?$"
      }
    },
    "registers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "intimate",
          "informal",
          "neutral",
          "formal",
          "academic",
          "professional",
          "bureaucratic",
          "literary"
        ]
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_schema",
        "learning_ir"
      ],
      "properties": {
        "material_schema": {
          "$ref": "#/$defs/VersionRange"
        },
        "learning_ir": {
          "$ref": "#/$defs/VersionRange"
        },
        "required_dlc_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        }
      }
    },
    "semantic_frames": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SemanticFrame"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Asset"
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Annotation"
      }
    },
    "generation_policy": {
      "$ref": "#/$defs/GenerationPolicy"
    },
    "safety": {
      "$ref": "#/$defs/Safety"
    },
    "license": {
      "$ref": "#/$defs/License"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "integrity": {
      "$ref": "#/$defs/Integrity"
    },
    "extensions": {
      "$ref": "#/$defs/Extensions"
    }
  },
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "SemVer": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "VersionRange": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[0-9<>=~^*., xX|+-]+$"
    },
    "LanguageTag": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "Extensions": {
      "type": "object",
      "default": {},
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
      },
      "additionalProperties": true
    },
    "LocalizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "text"
      ],
      "properties": {
        "language": {
          "$ref": "#/$defs/LanguageTag"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50000
        }
      }
    },
    "SemanticFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "frame_type",
        "communicative_intents",
        "participants",
        "facts"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "frame_type": {
          "enum": [
            "scenario",
            "event",
            "concept",
            "argument_structure",
            "discourse"
          ]
        },
        "titles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocalizedText"
          }
        },
        "communicative_intents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "role"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/Identifier"
              },
              "role": {
                "$ref": "#/$defs/Identifier"
              },
              "attributes": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              }
            }
          }
        },
        "facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "subject",
              "predicate",
              "object"
            ],
            "properties": {
              "subject": {
                "$ref": "#/$defs/Identifier"
              },
              "predicate": {
                "$ref": "#/$defs/Identifier"
              },
              "object": {},
              "immutable": {
                "type": "boolean",
                "default": false
              }
            }
          }
        },
        "lexical_candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "language",
              "lemma"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/Identifier"
              },
              "language": {
                "$ref": "#/$defs/LanguageTag"
              },
              "lemma": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "sense_ref": {
                "$ref": "#/$defs/Identifier"
              },
              "register": {
                "type": "string",
                "maxLength": 64
              },
              "frequency_band": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              }
            }
          }
        },
        "asset_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        }
      }
    },
    "Asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "uri",
        "media_type",
        "sha256",
        "size_bytes",
        "license"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "media_type": {
          "type": "string",
          "pattern": "^[a-z0-9.+-]+/[a-zA-Z0-9.+-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "language": {
          "$ref": "#/$defs/LanguageTag"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1
        },
        "transcript_asset_ref": {
          "$ref": "#/$defs/Identifier"
        },
        "source_uri": {
          "type": "string",
          "format": "uri"
        },
        "license": {
          "$ref": "#/$defs/License"
        },
        "generated": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "Annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target_ref",
        "annotation_type",
        "value",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "target_ref": {
          "$ref": "#/$defs/Identifier"
        },
        "annotation_type": {
          "enum": [
            "construction",
            "valency",
            "morphology",
            "phonology",
            "pragmatics",
            "difficulty",
            "safety",
            "license"
          ]
        },
        "value": {},
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "provenance": {
          "$ref": "#/$defs/AnnotationProvenance"
        }
      }
    },
    "AnnotationProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "created_at"
      ],
      "properties": {
        "method": {
          "enum": [
            "human",
            "rule",
            "model",
            "imported"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "actor_id": {
          "$ref": "#/$defs/Identifier"
        },
        "provider_id": {
          "$ref": "#/$defs/Identifier"
        },
        "model_version": {
          "type": "string",
          "maxLength": 200
        },
        "prompt_template_version": {
          "$ref": "#/$defs/SemVer"
        },
        "random_seed": {
          "type": "integer",
          "minimum": 0
        },
        "review_status": {
          "enum": [
            "unreviewed",
            "accepted",
            "rejected",
            "needs_revision"
          ]
        }
      }
    },
    "GenerationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_generation",
        "allowed_transformations",
        "immutable_paths",
        "human_review_required"
      ],
      "properties": {
        "allow_generation": {
          "type": "boolean"
        },
        "allowed_transformations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "surface_realization",
              "paraphrase",
              "level_adjustment",
              "translation",
              "dialogue_expansion",
              "lexical_substitution",
              "question_generation"
            ]
          }
        },
        "immutable_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/"
          }
        },
        "human_review_required": {
          "type": "boolean"
        },
        "maximum_generated_variants": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "Safety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content_labels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "minimum_age": {
          "type": "integer",
          "minimum": 0,
          "maximum": 21
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "License": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spdx_id",
        "commercial_use",
        "derivatives"
      ],
      "properties": {
        "spdx_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "license_uri": {
          "type": "string",
          "format": "uri"
        },
        "commercial_use": {
          "enum": [
            "allowed",
            "restricted",
            "unknown"
          ]
        },
        "derivatives": {
          "enum": [
            "allowed",
            "share_alike",
            "prohibited",
            "unknown"
          ]
        },
        "attribution": {
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at",
        "creators",
        "source_records"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "creators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "source_records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_uri",
              "retrieved_at"
            ],
            "properties": {
              "source_uri": {
                "type": "string",
                "format": "uri"
              },
              "retrieved_at": {
                "type": "string",
                "format": "date-time"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              }
            }
          }
        },
        "generation_runs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider_id",
              "model_version",
              "template_version",
              "created_at"
            ],
            "properties": {
              "provider_id": {
                "$ref": "#/$defs/Identifier"
              },
              "model_version": {
                "type": "string",
                "minLength": 1
              },
              "template_version": {
                "$ref": "#/$defs/SemVer"
              },
              "random_seed": {
                "type": "integer",
                "minimum": 0
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    "Integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_sha256"
      ],
      "properties": {
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "signature": {
          "type": "string",
          "minLength": 1
        },
        "key_id": {
          "$ref": "#/$defs/Identifier"
        }
      }
    }
  },
  "examples": [
    {
      "schema_version": "0.1.0",
      "pack_id": "material.de.hotel-checkin",
      "version": "0.1.0",
      "display_name": "Hotel Check-in Scenario",
      "pack_kind": "semantic_scenario",
      "languages": [
        "de-DE"
      ],
      "target_levels": [
        "A1",
        "A2"
      ],
      "registers": [
        "formal",
        "neutral"
      ],
      "compatibility": {
        "material_schema": ">=0.1.0 <0.2.0",
        "learning_ir": ">=0.1.0 <0.2.0",
        "required_dlc_capabilities": [
          "scenario.dialogue"
        ]
      },
      "semantic_frames": [
        {
          "id": "scenario.checkin",
          "frame_type": "scenario",
          "titles": [
            {
              "language": "de-DE",
              "text": "Im Hotel einchecken"
            }
          ],
          "communicative_intents": [
            "identify_self",
            "state_reservation",
            "request_information"
          ],
          "participants": [
            {
              "id": "guest",
              "role": "customer"
            },
            {
              "id": "receptionist",
              "role": "service_staff"
            }
          ],
          "facts": [
            {
              "subject": "guest",
              "predicate": "has_reservation",
              "object": true,
              "immutable": true
            }
          ],
          "lexical_candidates": [
            {
              "id": "lex.reservierung",
              "language": "de-DE",
              "lemma": "Reservierung",
              "frequency_band": 3
            }
          ]
        }
      ],
      "assets": [],
      "generation_policy": {
        "allow_generation": true,
        "allowed_transformations": [
          "surface_realization",
          "dialogue_expansion",
          "lexical_substitution"
        ],
        "immutable_paths": [
          "/semantic_frames/0/facts/0"
        ],
        "human_review_required": true,
        "maximum_generated_variants": 20
      },
      "license": {
        "spdx_id": "CC-BY-4.0",
        "commercial_use": "allowed",
        "derivatives": "allowed",
        "attribution": "Example scenario created for the language learning platform."
      },
      "provenance": {
        "created_at": "2026-08-14T12:00:00Z",
        "creators": [
          "platform-team"
        ],
        "source_records": []
      }
    }
  ]
}
