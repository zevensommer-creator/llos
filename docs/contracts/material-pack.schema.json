{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:language-learning-platform:schema:material-pack:0.2.1",
  "title": "Material Pack",
  "description": "Versioned, licensable material layer consumed by DLC compilers. v0.2.0: CEFR levels and registers become optional DLC/extension-declared references instead of universal Core truth; all annotation values use TypedValue; extensions use ExtensionEnvelope; generation lifecycle recorded (spec §2.7, §4.1). v0.2.1: adds required distribution_scope (ADR-012); license is optional for internal scope, mandatory (pack-level and asset-level) for public scope (ADR-013).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "version",
    "display_name",
    "pack_kind",
    "distribution_scope",
    "languages",
    "compatibility",
    "semantic_frames",
    "assets",
    "generation_policy",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.1"
    },
    "pack_id": {
      "$ref": "#/$defs/Identifier"
    },
    "version": {
      "$ref": "#/$defs/SemVer"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "pack_kind": {
      "enum": [
        "semantic_scenario",
        "authentic_corpus",
        "graded_reader",
        "domain_lexicon",
        "media_collection",
        "annotation_overlay",
        "mixed"
      ]
    },
    "distribution_scope": {
      "enum": ["internal", "public"],
      "description": "Distribution scope (ADR-012/ADR-013). internal: first-generation internal use—license optional, copyright process deferred. public: future public distribution—pack-level and asset-level license required, ADR-009 takedown process applies."
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/LanguageTag"
      }
    },
    "level_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scale_ref",
          "level_ref",
          "version"
        ],
        "properties": {
          "scale_ref": {
            "$ref": "#/$defs/Identifier"
          },
          "level_ref": {
            "$ref": "#/$defs/Identifier"
          },
          "version": {
            "$ref": "#/$defs/SemVer"
          }
        }
      },
      "description": "Optional versioned level references (e.g. a CEFR scale declared by a DLC or profile). Not a universal Core truth; Core assumes no scale exists (spec §4.2)."
    },
    "register_tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "description": "Free-form register tags. v0.1 fixed register enum (intimate/informal/neutral/formal/...) is abolished as Core truth; DLC profiles may declare their own vocabulary."
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_schema",
        "learning_ir"
      ],
      "properties": {
        "material_schema": {
          "$ref": "#/$defs/VersionRange"
        },
        "learning_ir": {
          "$ref": "#/$defs/VersionRange"
        },
        "required_dlc_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        }
      }
    },
    "lifecycle": {
      "enum": [
        "ephemeral",
        "private_saved",
        "published",
        "withdrawn"
      ],
      "default": "published",
      "description": "Generation lifecycle (spec §2.7). Saving a private asset or publishing requires verified creator capability; ephemeral generation is available to ordinary learners at runtime."
    },
    "semantic_frames": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SemanticFrame"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Asset"
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Annotation"
      }
    },
    "generation_policy": {
      "$ref": "#/$defs/GenerationPolicy"
    },
    "safety": {
      "$ref": "#/$defs/Safety"
    },
    "license": {
      "$ref": "#/$defs/License"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "integrity": {
      "$ref": "#/$defs/Integrity"
    },
    "extensions": {
      "$ref": "#/$defs/Extensions"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "distribution_scope": { "const": "public" }
        },
        "required": ["distribution_scope"]
      },
      "then": {
        "required": ["license"],
        "properties": {
          "assets": {
            "items": { "required": ["license"] }
          }
        }
      }
    }
  ],
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "SemVer": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "VersionRange": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[0-9<>=~^*., xX|+-]+$"
    },
    "LanguageTag": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "TypedValue": {
      "description": "Discriminated union for annotation and fact values. Arbitrary JSON is forbidden (spec §4.4).",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "string"],
          "properties": {
            "kind": { "const": "string" },
            "string": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "int"],
          "properties": {
            "kind": { "const": "int" },
            "int": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "float"],
          "properties": {
            "kind": { "const": "float" },
            "float": { "type": "number" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "bool"],
          "properties": {
            "kind": { "const": "bool" },
            "bool": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ref"],
          "properties": {
            "kind": { "const": "ref" },
            "ref": { "$ref": "#/$defs/Identifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "typed_list"],
          "properties": {
            "kind": { "const": "typed_list" },
            "typed_list": {
              "type": "array",
              "items": { "$ref": "#/$defs/TypedValue" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "artifact_ref"],
          "properties": {
            "kind": { "const": "artifact_ref" },
            "artifact_ref": { "$ref": "#/$defs/ArtifactRef" }
          },
          "description": "Complex values only as schema-validated artifact references, never inline arbitrary JSON."
        }
      ]
    },
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256"],
      "properties": {
        "uri": { "type": "string", "format": "uri" },
        "sha256": { "$ref": "#/$defs/Sha256" },
        "media_type": { "type": "string", "minLength": 1 },
        "schema_id": { "$ref": "#/$defs/Identifier" },
        "schema_version": { "$ref": "#/$defs/SemVer" }
      }
    },
    "ExtensionEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_version", "payload_ref"],
      "properties": {
        "schema_id": { "$ref": "#/$defs/Identifier" },
        "schema_version": { "$ref": "#/$defs/SemVer" },
        "payload_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["uri", "sha256"],
          "properties": {
            "uri": { "type": "string", "format": "uri" },
            "sha256": { "$ref": "#/$defs/Sha256" }
          }
        }
      }
    },
    "Extensions": {
      "type": "object",
      "default": {},
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/ExtensionEnvelope"
      },
      "description": "Extension fields require explicit schema ID and version; unregistered extensions or hash mismatches are rejected (spec §4.4)."
    },
    "LocalizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "text"],
      "properties": {
        "language": { "$ref": "#/$defs/LanguageTag" },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50000
        }
      }
    },
    "SemanticFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "frame_type", "communicative_intents", "participants", "facts"],
      "properties": {
        "id": { "$ref": "#/$defs/Identifier" },
        "frame_type": {
          "enum": ["scenario", "event", "concept", "argument_structure", "discourse"]
        },
        "titles": {
          "type": "array",
          "items": { "$ref": "#/$defs/LocalizedText" }
        },
        "communicative_intents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Identifier" }
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "role"],
            "properties": {
              "id": { "$ref": "#/$defs/Identifier" },
              "role": { "$ref": "#/$defs/Identifier" },
              "attributes": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/TypedValue"
                }
              }
            }
          }
        },
        "facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["subject", "predicate", "object"],
            "properties": {
              "subject": { "$ref": "#/$defs/Identifier" },
              "predicate": { "$ref": "#/$defs/Identifier" },
              "object": { "$ref": "#/$defs/TypedValue" },
              "immutable": { "type": "boolean", "default": false }
            }
          }
        },
        "lexical_candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "language", "lemma"],
            "properties": {
              "id": { "$ref": "#/$defs/Identifier" },
              "language": { "$ref": "#/$defs/LanguageTag" },
              "lemma": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "sense_ref": { "$ref": "#/$defs/Identifier" },
              "register_tag": {
                "type": "string",
                "maxLength": 64
              },
              "frequency_band": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              }
            }
          }
        },
        "asset_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Identifier" }
        }
      }
    },
    "Asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "uri", "media_type", "sha256", "size_bytes"],
      "properties": {
        "id": { "$ref": "#/$defs/Identifier" },
        "uri": { "type": "string", "format": "uri" },
        "media_type": {
          "type": "string",
          "pattern": "^[a-z0-9.+-]+/[a-zA-Z0-9.+-]+$"
        },
        "sha256": { "$ref": "#/$defs/Sha256" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "language": { "$ref": "#/$defs/LanguageTag" },
        "duration_ms": { "type": "integer", "minimum": 1 },
        "transcript_asset_ref": { "$ref": "#/$defs/Identifier" },
        "source_uri": { "type": "string", "format": "uri" },
        "license": { "$ref": "#/$defs/License" },
        "generated": { "type": "boolean", "default": false }
      }
    },
    "Annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target_ref", "annotation_type", "value", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/Identifier" },
        "target_ref": { "$ref": "#/$defs/Identifier" },
        "annotation_type": {
          "enum": [
            "construction",
            "valency",
            "morphology",
            "phonology",
            "pragmatics",
            "difficulty",
            "safety",
            "license",
            "custom"
          ],
          "description": "Material-layer annotation categories. 'custom' requires type_schema_ref so DLC profiles can declare their own vocabulary without corrupting the ABI."
        },
        "type_schema_ref": {
          "$ref": "#/$defs/Identifier",
          "description": "Required for annotation_type=custom: the DLC/profile-declared schema identifying the annotation vocabulary."
        },
        "value": {
          "$ref": "#/$defs/TypedValue"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "provenance": { "$ref": "#/$defs/AnnotationProvenance" }
      }
    },
    "AnnotationProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "created_at"],
      "properties": {
        "method": { "enum": ["human", "rule", "model", "imported"] },
        "created_at": { "type": "string", "format": "date-time" },
        "actor_id": { "$ref": "#/$defs/Identifier" },
        "provider_id": { "$ref": "#/$defs/Identifier" },
        "model_version": { "type": "string", "maxLength": 200 },
        "prompt_template_version": { "$ref": "#/$defs/SemVer" },
        "random_seed": { "type": "integer", "minimum": 0 },
        "review_status": {
          "enum": ["unreviewed", "accepted", "rejected", "needs_revision"]
        }
      }
    },
    "GenerationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow_generation", "allowed_transformations", "immutable_paths", "human_review_required"],
      "properties": {
        "allow_generation": { "type": "boolean" },
        "allowed_transformations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "surface_realization",
              "paraphrase",
              "level_adjustment",
              "translation",
              "dialogue_expansion",
              "lexical_substitution",
              "question_generation"
            ]
          }
        },
        "immutable_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/"
          }
        },
        "human_review_required": { "type": "boolean" },
        "maximum_generated_variants": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "Safety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content_labels": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 80 }
        },
        "minimum_age": { "type": "integer", "minimum": 0, "maximum": 21 },
        "notes": { "type": "string", "maxLength": 2000 }
      }
    },
    "License": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx_id", "commercial_use", "derivatives"],
      "properties": {
        "spdx_id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "license_uri": { "type": "string", "format": "uri" },
        "commercial_use": { "enum": ["allowed", "restricted", "unknown"] },
        "derivatives": { "enum": ["allowed", "share_alike", "prohibited", "unknown"] },
        "attribution": { "type": "string", "maxLength": 4000 }
      }
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "creators", "source_records"],
      "properties": {
        "created_at": { "type": "string", "format": "date-time" },
        "creators": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "source_records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_uri", "retrieved_at"],
            "properties": {
              "source_uri": { "type": "string", "format": "uri" },
              "retrieved_at": { "type": "string", "format": "date-time" },
              "sha256": { "$ref": "#/$defs/Sha256" }
            }
          }
        },
        "generation_runs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider_id", "model_version", "template_version", "created_at"],
            "properties": {
              "provider_id": { "$ref": "#/$defs/Identifier" },
              "model_version": { "type": "string", "minLength": 1 },
              "template_version": { "$ref": "#/$defs/SemVer" },
              "random_seed": { "type": "integer", "minimum": 0 },
              "created_at": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    "Integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256"],
      "properties": {
        "manifest_sha256": { "$ref": "#/$defs/Sha256" },
        "signature": { "type": "string", "minLength": 1 },
        "key_id": { "$ref": "#/$defs/Identifier" }
      }
    }
  },
  "examples": [
    {
      "schema_version": "0.2.1",
      "pack_id": "material.de.hotel-checkin",
      "version": "0.2.0",
      "display_name": "Hotel Check-in Scenario",
      "pack_kind": "semantic_scenario",
      "distribution_scope": "public",
      "languages": ["de-DE"],
      "level_refs": [
        {
          "scale_ref": "scale.cefr",
          "level_ref": "A1",
          "version": "2001.0.0"
        }
      ],
      "register_tags": ["formal", "neutral"],
      "compatibility": {
        "material_schema": ">=0.2.0 <0.3.0",
        "learning_ir": ">=0.2.0 <0.3.0",
        "required_dlc_capabilities": ["scenario.dialogue"]
      },
      "lifecycle": "published",
      "semantic_frames": [
        {
          "id": "scenario.checkin",
          "frame_type": "scenario",
          "titles": [
            { "language": "de-DE", "text": "Im Hotel einchecken" }
          ],
          "communicative_intents": ["identify_self", "state_reservation", "request_information"],
          "participants": [
            { "id": "guest", "role": "customer" },
            { "id": "receptionist", "role": "service_staff" }
          ],
          "facts": [
            {
              "subject": "guest",
              "predicate": "has_reservation",
              "object": { "kind": "bool", "bool": true },
              "immutable": true
            }
          ],
          "lexical_candidates": [
            {
              "id": "lex.reservierung",
              "language": "de-DE",
              "lemma": "Reservierung",
              "frequency_band": 3
            }
          ]
        }
      ],
      "assets": [],
      "generation_policy": {
        "allow_generation": true,
        "allowed_transformations": ["surface_realization", "dialogue_expansion", "lexical_substitution"],
        "immutable_paths": ["/semantic_frames/0/facts/0"],
        "human_review_required": true,
        "maximum_generated_variants": 20
      },
      "license": {
        "spdx_id": "CC-BY-4.0",
        "commercial_use": "allowed",
        "derivatives": "allowed",
        "attribution": "Example scenario created for the language learning platform."
      },
      "provenance": {
        "created_at": "2026-08-15T12:00:00Z",
        "creators": ["platform-team"],
        "source_records": []
      }
    }
  ]
}
