{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:language-learning-platform:schema:pronunciation-assessment:0.1.0",
  "title": "Pronunciation Assessment",
  "description": "Evidence-bearing pronunciation report with explicit audio quality, alignment, language calibration, uncertainty and abstention.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "session_id",
    "activity_id",
    "created_at",
    "language",
    "mode",
    "status",
    "audio_ref",
    "audio_quality",
    "reference",
    "recognition",
    "alignment",
    "dimensions",
    "words",
    "evidence",
    "issues",
    "abstentions",
    "calibration",
    "component_versions",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "assessment_id": {
      "$ref": "#/$defs/Identifier"
    },
    "session_id": {
      "$ref": "#/$defs/Identifier"
    },
    "activity_id": {
      "$ref": "#/$defs/Identifier"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "language": {
      "$ref": "#/$defs/LanguageTag"
    },
    "mode": {
      "enum": [
        "read_aloud",
        "shadowing",
        "constrained_response",
        "open_speech"
      ]
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "abstained",
        "failed"
      ]
    },
    "audio_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "audio_quality": {
      "$ref": "#/$defs/AudioQuality"
    },
    "reference": {
      "$ref": "#/$defs/Reference"
    },
    "recognition": {
      "$ref": "#/$defs/Recognition"
    },
    "alignment": {
      "$ref": "#/$defs/Alignment"
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Dimension"
      }
    },
    "words": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/WordAssessment"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Evidence"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Issue"
      }
    },
    "abstentions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Abstention"
      }
    },
    "calibration": {
      "$ref": "#/$defs/Calibration"
    },
    "component_versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ComponentVersion"
      }
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Diagnostic"
      }
    },
    "extensions": {
      "$ref": "#/$defs/Extensions"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "abstained"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "abstentions": {
            "minItems": 1
          },
          "issues": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "diagnostics"
        ],
        "properties": {
          "diagnostics": {
            "minItems": 1
          },
          "issues": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "SemVer": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "LanguageTag": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "Extensions": {
      "type": "object",
      "default": {},
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
      },
      "additionalProperties": true
    },
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "sha256"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "Interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_ms",
        "end_ms"
      ],
      "properties": {
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "AudioQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "speech_duration_ms",
        "snr_db",
        "clipping_ratio",
        "silence_ratio",
        "channel_count",
        "sample_rate_hz"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "degraded",
            "rejected"
          ]
        },
        "speech_duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "snr_db": {
          "type": [
            "number",
            "null"
          ]
        },
        "clipping_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "silence_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "channel_count": {
          "type": "integer",
          "minimum": 1
        },
        "sample_rate_hz": {
          "type": "integer",
          "minimum": 8000
        },
        "quality_flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "too_short",
              "too_long",
              "low_snr",
              "clipping",
              "multiple_speakers",
              "music",
              "unsupported_format",
              "vad_uncertain"
            ]
          }
        }
      }
    },
    "Reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_type",
        "text",
        "pronunciation_graph_ref",
        "language_profile_ref",
        "acceptable_variant_policy_version"
      ],
      "properties": {
        "reference_type": {
          "enum": [
            "exact_text",
            "answer_graph",
            "resolved_transcript"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "normalized_text": {
          "type": "string",
          "maxLength": 20000
        },
        "pronunciation_graph_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "language_profile_ref": {
          "type": "string",
          "format": "uri-reference"
        },
        "acceptable_variant_policy_version": {
          "$ref": "#/$defs/SemVer"
        }
      }
    },
    "Recognition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "hypotheses"
      ],
      "properties": {
        "status": {
          "enum": [
            "completed",
            "partial",
            "failed",
            "not_run"
          ]
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "rank",
              "confidence"
            ],
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 20000
              },
              "rank": {
                "type": "integer",
                "minimum": 1
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "content_match": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "completeness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "insertions": {
              "type": "integer",
              "minimum": 0
            },
            "deletions": {
              "type": "integer",
              "minimum": 0
            },
            "substitutions": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "Alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "coverage",
        "mean_confidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "completed",
            "partial",
            "failed",
            "not_applicable"
          ]
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mean_confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "artifact_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "failure_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
        }
      }
    },
    "Dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "confidence",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "enum": [
            "phoneme_accuracy",
            "vowel_quantity",
            "vowel_quality",
            "word_stress",
            "prosody",
            "fluency",
            "completeness",
            "intelligibility"
          ]
        },
        "status": {
          "enum": [
            "scored",
            "abstained",
            "not_applicable"
          ]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "abstention_ref": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "scored"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "score"
            ],
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "abstained"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "abstention_ref"
            ]
          }
        }
      ]
    },
    "WordAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "word_id",
        "text",
        "interval",
        "alignment_confidence",
        "phones",
        "issue_refs"
      ],
      "properties": {
        "word_id": {
          "$ref": "#/$defs/Identifier"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "interval": {
          "$ref": "#/$defs/Interval"
        },
        "alignment_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "phones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PhoneAssessment"
          }
        },
        "stress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "expected_syllable": {
              "type": "integer",
              "minimum": 1
            },
            "observed_syllable": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "issue_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        }
      }
    },
    "PhoneAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phone_id",
        "expected",
        "interval",
        "status",
        "confidence",
        "evidence_refs"
      ],
      "properties": {
        "phone_id": {
          "$ref": "#/$defs/Identifier"
        },
        "expected": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "observed_candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "phone",
              "confidence"
            ],
            "properties": {
              "phone": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "interval": {
          "$ref": "#/$defs/Interval"
        },
        "status": {
          "enum": [
            "acceptable",
            "issue",
            "uncertain",
            "not_aligned"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "issue_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        }
      }
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "kind",
        "value",
        "confidence",
        "source_component_ref"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/Identifier"
        },
        "kind": {
          "enum": [
            "audio_quality",
            "asr_hypothesis",
            "alignment",
            "gop",
            "ctc_posterior",
            "duration",
            "formant",
            "f0",
            "intensity",
            "pause",
            "language_rule",
            "human_annotation"
          ]
        },
        "value": {},
        "unit": {
          "type": "string",
          "maxLength": 40
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "interval": {
          "$ref": "#/$defs/Interval"
        },
        "target_ref": {
          "$ref": "#/$defs/Identifier"
        },
        "source_component_ref": {
          "$ref": "#/$defs/Identifier"
        },
        "artifact_ref": {
          "$ref": "#/$defs/ArtifactRef"
        }
      }
    },
    "Issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_id",
        "category",
        "status",
        "severity",
        "target",
        "location",
        "confidence",
        "evidence_refs",
        "feedback_key"
      ],
      "properties": {
        "issue_id": {
          "$ref": "#/$defs/Identifier"
        },
        "category": {
          "enum": [
            "phoneme_substitution",
            "phoneme_deletion",
            "phoneme_insertion",
            "vowel_quantity",
            "vowel_quality",
            "front_rounded_vowel",
            "ich_ach_laut",
            "final_devoicing",
            "stop_aspiration",
            "word_stress",
            "completeness",
            "fluency",
            "prosody",
            "other"
          ]
        },
        "status": {
          "enum": [
            "confirmed",
            "suspected"
          ]
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "observed": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "location": {
          "$ref": "#/$defs/Interval"
        },
        "word_ref": {
          "$ref": "#/$defs/Identifier"
        },
        "phone_ref": {
          "$ref": "#/$defs/Identifier"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "feedback_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
        },
        "pedagogical_priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "Abstention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "abstention_id",
        "scope",
        "reason_code",
        "message"
      ],
      "properties": {
        "abstention_id": {
          "$ref": "#/$defs/Identifier"
        },
        "scope": {
          "enum": [
            "assessment",
            "dimension",
            "word",
            "phone",
            "issue"
          ]
        },
        "target_ref": {
          "$ref": "#/$defs/Identifier"
        },
        "reason_code": {
          "enum": [
            "audio_quality",
            "insufficient_speech",
            "asr_disagreement",
            "alignment_failed",
            "alignment_low_confidence",
            "acceptable_variant_ambiguous",
            "out_of_calibration_domain",
            "evidence_conflict",
            "unsupported_language_feature",
            "provider_failure"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        }
      }
    },
    "Calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language_profile_id",
        "language_profile_version",
        "calibrator_id",
        "calibrator_version",
        "threshold_set_version",
        "domain_status"
      ],
      "properties": {
        "language_profile_id": {
          "$ref": "#/$defs/Identifier"
        },
        "language_profile_version": {
          "$ref": "#/$defs/SemVer"
        },
        "calibrator_id": {
          "$ref": "#/$defs/Identifier"
        },
        "calibrator_version": {
          "$ref": "#/$defs/SemVer"
        },
        "threshold_set_version": {
          "$ref": "#/$defs/SemVer"
        },
        "domain_status": {
          "enum": [
            "in_domain",
            "partially_in_domain",
            "out_of_domain",
            "unknown"
          ]
        },
        "learner_l1_group": {
          "$ref": "#/$defs/LanguageTag"
        },
        "device_class": {
          "type": "string",
          "maxLength": 80
        },
        "validation_report_ref": {
          "$ref": "#/$defs/ArtifactRef"
        }
      }
    },
    "ComponentVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_ref",
        "role",
        "provider_id",
        "model_id",
        "model_version"
      ],
      "properties": {
        "component_ref": {
          "$ref": "#/$defs/Identifier"
        },
        "role": {
          "enum": [
            "vad",
            "asr",
            "g2p",
            "alignment",
            "gop",
            "ctc",
            "prosody",
            "calibration",
            "feedback"
          ]
        },
        "provider_id": {
          "$ref": "#/$defs/Identifier"
        },
        "model_id": {
          "$ref": "#/$defs/Identifier"
        },
        "model_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "configuration_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipeline_version",
        "input_sha256",
        "random_seed",
        "started_at",
        "finished_at",
        "usage"
      ],
      "properties": {
        "pipeline_version": {
          "$ref": "#/$defs/SemVer"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "random_seed": {
          "type": "integer",
          "minimum": 0
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "latency_ms",
            "cpu_seconds",
            "gpu_seconds",
            "cost_usd"
          ],
          "properties": {
            "latency_ms": {
              "type": "integer",
              "minimum": 0
            },
            "cpu_seconds": {
              "type": "number",
              "minimum": 0
            },
            "gpu_seconds": {
              "type": "number",
              "minimum": 0
            },
            "cost_usd": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "Diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "retryable": {
          "type": "boolean"
        }
      }
    }
  },
